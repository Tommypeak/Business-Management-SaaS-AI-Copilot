# Local development only. Copy to .env and replace both password placeholders.
NODE_ENV=development

POSTGRES_DB=business_management
POSTGRES_USER=saas
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432
# URL-encode special characters in the password. Keep credentials in sync above.
DATABASE_URL=postgresql://saas:replace_with_local_password@127.0.0.1:5432/business_management?schema=public

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

API_PORT=3001
API_HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_PORT=3000
WEB_HOST=127.0.0.1
AI_PORT=8000
AI_HOST=127.0.0.1
AI_ENVIRONMENT=development

# External identity: issuer URL namespaces local users. Configure both together.
AUTH_ISSUER=
AUTH_JWKS_URL=
# Optional: if set, the JWT must contain this audience.
AUTH_AUDIENCE=
# Recommended for Clerk: comma-separated origins allowed to obtain session tokens.
AUTH_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Clerk is used only by web. Secret key is server-only; do not prefix it NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Server-side web-to-API URL, not a browser token store or proxy to arbitrary hosts.
API_BASE_URL=http://127.0.0.1:3001/api/v1

# Integration tests use an isolated temporary PostgreSQL schema, never db push.
# Point this at a dedicated test database. Required by pnpm test.
TEST_DATABASE_URL=
