{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "scripts/**"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "API_PORT",
    "API_HOST",
    "API_CORS_ORIGINS",
    "WEB_PORT",
    "WEB_HOST",
    "AI_PORT",
    "AI_HOST",
    "AI_ENVIRONMENT",
    "AI_SERVICE_URL",
    "AI_SERVICE_SECRET",
    "AI_PROVIDER",
    "AI_MODEL",
    "AI_PROVIDER_API_KEY",
    "AI_PROVIDER_BASE_URL",
    "AI_REQUEST_TIMEOUT_MS",
    "AI_TURN_TIMEOUT_MS",
    "AI_MAX_OUTPUT_TOKENS",
    "AI_MAX_CONTEXT_CHARACTERS",
    "AI_MAX_TOOL_CALLS",
    "AI_MAX_TOOL_ROUNDS",
    "AI_USER_REQUESTS_PER_HOUR",
    "AI_ORG_REQUESTS_PER_DAY",
    "UV_PYTHON",
    "CI",
    "AUTH_ISSUER",
    "AUTH_JWKS_URL",
    "AUTH_AUDIENCE",
    "AUTH_AUTHORIZED_PARTIES",
    "CLERK_SECRET_KEY",
    "API_BASE_URL",
    "TEST_DATABASE_URL"
  ],
  "globalEnv": ["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"],
  "tasks": {
    "generate": { "cache": false },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "dependsOn": ["^build", "generate"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["generate"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build", "generate"], "outputs": [] },
    "test": { "dependsOn": ["^build", "generate"], "cache": false, "outputs": [] }
  }
}
